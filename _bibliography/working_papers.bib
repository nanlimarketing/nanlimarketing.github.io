@article{li_procurement_2026,
    title = {Cheaper Drugs, Not Cheaper Care: Evidence from Centralized Procurement},
    author = {Li, Nan, and Li, Xu and Li, Yuanchen and Song, Xiuguo and Zhao, Heng},
    year = {2026},
    html = {https://papers.ssrn.com/sol3/papers.cfm?abstract_id=7107838},
    keywords = {centralized procurement; group purchasing; moral hazard; supply chain incentives; healthcare operations; difference-in-differences},
    abstract = {Centralized procurement is designed to lower input prices by pooling demand across downstream providers. Whether these price reductions translate into lower spending for final users, however, remains unclear. Procurement may cover only one component of a product bundle, whereas downstream providers retain discretion over the rest. In this paper, we study this question in the context of China's National Volume-Based Procurement (NVBP) reform, a national government-run group purchasing program for pharmaceuticals. Using a difference-in-differences design, we analyze a unique patient-visit-level panel of outpatient visits from multiple hospitals in a Chinese province. We find that NVBP reduces patients' spending on disease-related core drugs by 16.4%. However, much of the resulting savings is offset, leaving total medical expenditure without a statistically or economically meaningful decline. We identify two channels driving this offset. First, providers expand the quantity and expenditure of non-procured auxiliary prescriptions. This pattern is consistent with providers shifting prescriptions toward components of the treatment bundle that remain outside the procurement contract. Second, patients visit hospitals more frequently and experience more active adjustment of their core-drug regimens, with more core-drug items changed between consecutive visits and more items new to their prescription histories. These regimen changes indicate that procurement affected the broader process of medication management. We further show that savings concentrate in non-tertiary hospitals located in the provincial capital. Taken together, our findings suggest that the procurement price is only an intermediate measure of performance when the buyer contracts on one component of the product bundle and is not the final user. The final savings also depend on how downstream providers adjust decisions that remain outside the procurement contract.}
}

@article{haviv_buynotuse_2025,
    title = {Non-Usage in Digital Marketplaces: Evidence from Eight Years of Steam Usage},
    author = {Haviv, Avery and Li, Nan},
    year = {2026},
    html = {https://papers.ssrn.com/sol3/papers.cfm?abstract_id=5735826},
    keywords = {Empirics-First Approach, Non-usage behavior, Digital Goods, Behavioral biases, Steam platform},
    abstract = {In this descriptive paper, we study non-usage, where consumers purchase products that they never use. We assemble a panel dataset from Steam, the world's largest PC gaming platform, linking purchases to subsequent usage over an eight-year window for tens of thousands of users. Non-usage is widespread: 28.8 percent of purchased games are never played, representing 19.4 percent of revenue from game sales and roughly $512 million in 2017 spending. Discounted purchases and purchases during sales events are less likely to go unused. Non-usage rises sharply when games are bought several at a time, and falls with a game's quality. After buying a game that goes unused, consumers do not reduce their subsequent purchasing, spending, or playtime. We discuss which explanations for non-usage are consistent with these patterns, and draw implications for consumers, platforms, and regulators.}
}

@article{cao_spillover_2025,
    title = {The {Spillover} {Effects} of {Copycat} {Apps} and {App} {Platform} {Governance}},
    html = {https://papers.ssrn.com/abstract=4250292},
    doi = {10.2139/ssrn.4250292},
    abstract = {From taking inspiration to outright copying, new apps are frequently developed using the ideas of successful competitors.  Mobile app platforms (markets), such as the Apple App Store and the Google Play Store, have policies intended to screen these "copycat'' apps.     We study the effect these "copycat'' apps have on incumbents by leveraging data from multiple Android app markets in China.   We identify which apps copied others using a supervised machine-learning approach. Our identification strategy leverages the fact that we observe the same app competing against different competitors on different platforms. We find that on average copycats do not reduce the demand for incumbent apps.  However, moderators of this effect show that the largest and most highly rated apps are harmed by the presence of copycats. Furthermore, copycats cause developers of incumbent apps to behave differently.  Higher-quality incumbents change their descriptions to differentiate themselves from low-quality copycats. Our results show that the filtering of copycat apps does not confer significant benefits to app developers, which may inform recent discussions on the value that app platforms provide.},
    author = {Cao, Jingcun and Haviv, Avery and Li, Nan},
    month = feb,
    year = {2025},
    keywords = {Android, App, App Store, Copycat, Platforms, Play Store, Spillovers}
}
