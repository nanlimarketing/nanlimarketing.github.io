@article{li_procurement_2026,
    title = {Price Cuts Without Savings: Moral Hazards in Volume-Based Centralized Procurement},
    author = {Nan Li, Xu Li, Yuanchen Li, Xiuguo Song, and Heng Zhao},
    year = {2026},
    html = {},
    keywords = {centralized procurement; group purchasing; moral hazard; supply chain incentives; healthcare operations; difference-in-differences},
    abstract = {Centralized procurement is designed to lower input prices by pooling demand across downstream providers. Whether these price reductions translate into lower spending for final users, however, is unclear when procurement covers only one component of a product bundle and does not fully specify the product's post-award quality. In this paper, we study this question in the context of China's National Volume-Based Procurement (NVBP) reform, a national government-run group purchasing program for pharmaceuticals. Using a difference-in-differences design, we analyze a unique patient-visit-level panel of outpatient visits from multiple hospitals in a Chinese province. We find that NVBP reduces patients' spending on the contracted core drugs by 10.1\%, yet patients' total medical expenditure does not decline by a statistically or economically meaningful amount. We identify two channels that help explain this limited pass-through. First, providers expand the quantity of non-procured auxiliary prescriptions, consistent with downstream agents shifting toward the margins that remain outside the procurement contract and retain positive markups. Second, patients visit hospitals more frequently and experience more active adjustment of their core-drug regimens, with more core-drug items changed between consecutive visits and more items new to their prescription histories, consistent with an upstream quality response under price-and-volume auctions with limited post-award quality monitoring. We further show that savings concentrate among patients with low historical visit frequency and among those treated in non-tertiary hospitals located in the provincial capital. Taken together, our findings suggest that centralized procurement design should not focus on price reductions alone. When the buyer contracts on only part of a treatment bundle and is not the final user, realized savings depend on both upstream quality incentives and downstream substitution toward non-contracted margins.}
}

@article{haviv_buynotuse_2025,
    title = {Buy Now, Play Never: Why Consumers Purchase Things They Don't Use},
    author = {Haviv, Avery and Li, Nan},
    year = {2025},
    html = {https://papers.ssrn.com/sol3/papers.cfm?abstract_id=5735826},
    keywords = {Empirics-First Approach, Non-usage behavior, Digital Goods, Behavioral biases, Steam platform},
    abstract = {In this paper, we study non-usage, where consumers purchase products that they never use. This behavior may lower consumer welfare and lead to consumer churn. Using an Empirics-First approach (Golder et al. 2023), we assemble and analyze a rich panel data set from Steam, the leading digital PC gaming platform, linking purchases to subsequent usage over an eight-year horizon for tens of thousands of users. We estimate that 36.8 percent of purchased games are never played, representing 28.9 percent of platform revenue and approximately $849 million in 2017 spending.

Combining model-free evidence with descriptive regressions, we document empirical patterns in non-usage and assess which mechanisms align with them. The evidence is most consistent with behavioral mechanisms, particularly inattention and overestimation of variety seeking, suggesting that non-usage largely reflects consumer mistakes rather than utility-maximizing behavior.

We also test whether unused purchases reduce future engagement and find non-usage raises short-run revenue without eroding longer-run platform revenue or engagement. We conclude with recommendations for how consumers, platforms, and regulators can manage non-usage.}
}

@article{cao_spillover_2025,
    title = {The {Spillover} {Effects} of {Copycat} {Apps} and {App} {Platform} {Governance}},
    html = {https://papers.ssrn.com/abstract=4250292},
    doi = {10.2139/ssrn.4250292},
    abstract = {From taking inspiration to outright copying, new apps are frequently developed using the ideas of successful competitors.  Mobile app platforms (markets), such as the Apple App Store and the Google Play Store, have policies intended to screen these "copycat'' apps.     We study the effect these "copycat'' apps have on incumbents by leveraging data from multiple Android app markets in China.   We identify which apps copied others using a supervised machine-learning approach. Our identification strategy leverages the fact that we observe the same app competing against different competitors on different platforms. We find that on average copycats do not reduce the demand for incumbent apps.  However, moderators of this effect show that the largest and most highly rated apps are harmed by the presence of copycats. Furthermore, copycats cause developers of incumbent apps to behave differently.  Higher-quality incumbents change their descriptions to differentiate themselves from low-quality copycats. Our results show that the filtering of copycat apps does not confer significant benefits to app developers, which may inform recent discussions on the value that app platforms provide.},
    author = {Cao, Jingcun and Haviv, Avery and Li, Nan},
    month = feb,
    year = {2025},
    keywords = {Android, App, App Store, Copycat, Platforms, Play Store, Spillovers}
}
